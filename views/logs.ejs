<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="font-serif text-3xl text-amber-200">遊戲紀錄</h2>
      <p class="mt-1 text-sm text-slate-400">以 gamedate（GMT+8 日期字串）篩選區間</p>
    </div>
    <a
      class="rounded-lg border border-emerald-400/40 bg-emerald-500/15 px-4 py-2 text-emerald-200 hover:bg-emerald-500/25"
      href="/dashboard/logs/export.xlsx?from=<%= encodeURIComponent(from) %>&to=<%= encodeURIComponent(to) %>"
    >下載 XLSX</a>
  </div>

  <form method="get" action="/dashboard/logs" class="flex flex-wrap items-end gap-3 rounded-2xl border border-white/10 bg-white/5 p-4">
    <label class="text-sm">
      <span class="text-slate-400">由</span>
      <input class="mt-1 block rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="date" name="from" value="<%= from %>" required />
    </label>
    <label class="text-sm">
      <span class="text-slate-400">至</span>
      <input class="mt-1 block rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="date" name="to" value="<%= to %>" required />
    </label>
    <button class="rounded-lg bg-sky-500 px-4 py-2 text-slate-950 hover:bg-sky-400" type="submit">查詢</button>
  </form>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h3 class="text-lg text-amber-100">趨勢圖</h3>
        <p class="text-sm text-slate-400"><%= from %> 至 <%= to %>（GMT+8）</p>
      </div>
      <p class="text-sm text-slate-400">平均遊戲時間 <span class="font-mono text-base text-rose-200"><%= chart.avgLabel %></span></p>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-sky-400/20 bg-sky-500/10 px-3 py-2">
        <p class="text-xs text-slate-400">遊玩人數</p>
        <p class="text-2xl font-semibold text-sky-300"><%= chart.players %></p>
        <p class="text-xs text-slate-500">不重複 device_id</p>
      </div>
      <div class="rounded-xl border border-amber-400/20 bg-amber-500/10 px-3 py-2">
        <p class="text-xs text-slate-400">總遊玩次數</p>
        <p class="text-2xl font-semibold text-amber-200"><%= chart.plays %></p>
        <p class="text-xs text-slate-500">Game Log 筆數</p>
      </div>
      <div class="rounded-xl border border-emerald-400/20 bg-emerald-500/10 px-3 py-2">
        <p class="text-xs text-slate-400">Visual 次數</p>
        <p class="text-2xl font-semibold text-emerald-300"><%= chart.visualCount %></p>
        <p class="text-xs text-slate-500">不重複關卡數</p>
      </div>
      <div class="rounded-xl border border-rose-400/20 bg-rose-500/10 px-3 py-2">
        <p class="text-xs text-slate-400">平均遊戲時間</p>
        <p class="font-mono text-2xl font-semibold text-rose-200"><%= chart.avgLabel %></p>
        <p class="text-xs text-slate-500">mm:ss.mmm</p>
      </div>
    </div>
    <div class="mt-4 overflow-x-auto">
      <div style="min-width: <%= Math.max(640, chart.labels.length * 56) %>px; height: 280px;">
        <canvas id="rangeChart"></canvas>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto rounded-2xl border border-white/10">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-white/5 text-slate-300">
        <tr>
          <th class="px-3 py-2">ref_id</th>
          <th class="px-3 py-2">device_id</th>
          <th class="px-3 py-2">gamedate</th>
          <th class="px-3 py-2">start</th>
          <th class="px-3 py-2">end</th>
          <th class="px-3 py-2">visual</th>
          <th class="px-3 py-2">correct</th>
          <th class="px-3 py-2">incorrect</th>
          <th class="px-3 py-2">completion</th>
          <th class="px-3 py-2">建立(HKT)</th>
        </tr>
      </thead>
      <tbody>
        <% if (!logs.length) { %>
        <tr><td class="px-3 py-6 text-slate-500" colspan="10">此區間沒有紀錄</td></tr>
        <% } %>
        <% logs.forEach(function (log) { %>
        <tr class="border-t border-white/5 hover:bg-white/[0.03]">
          <td class="px-3 py-2 font-mono text-xs"><%= log.ref_id %></td>
          <td class="px-3 py-2"><%= log.device_id %></td>
          <td class="px-3 py-2"><%= log.gamedate %></td>
          <td class="px-3 py-2"><%= log.start_time %></td>
          <td class="px-3 py-2"><%= log.end_time %></td>
          <td class="px-3 py-2"><%= log.game_visual_no %></td>
          <td class="px-3 py-2 text-emerald-300"><%= log.correct %></td>
          <td class="px-3 py-2 text-rose-300"><%= log.incorrect %></td>
          <td class="px-3 py-2 font-mono"><%= log.completionLabel %></td>
          <td class="px-3 py-2 text-slate-400"><%= log.createdAtHkt %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script>
  const rangeStats = <%- chartJson %>;
  const lineStyle = {
    tension: 0.35,
    borderWidth: 2,
    pointRadius: 4,
    pointHoverRadius: 5,
    pointBackgroundColor: '#0f172a',
    pointBorderWidth: 2,
    fill: false,
  };
  new Chart(document.getElementById('rangeChart'), {
    type: 'line',
    data: {
      labels: rangeStats.labels,
      datasets: [
        {
          ...lineStyle,
          label: '遊玩人數',
          data: rangeStats.playersByDay,
          borderColor: '#38bdf8',
          pointBorderColor: '#38bdf8',
          yAxisID: 'y',
        },
        {
          ...lineStyle,
          label: '總遊玩次數',
          data: rangeStats.playsByDay,
          borderColor: '#fbbf24',
          pointBorderColor: '#fbbf24',
          yAxisID: 'y',
        },
        {
          ...lineStyle,
          label: 'Visual 次數',
          data: rangeStats.visualsByDay,
          borderColor: '#34d399',
          pointBorderColor: '#34d399',
          yAxisID: 'y',
        },
        {
          ...lineStyle,
          label: '平均遊戲時間',
          data: rangeStats.avgByDay,
          borderColor: '#fb7185',
          pointBorderColor: '#fb7185',
          yAxisID: 'y1',
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: '#cbd5e1', usePointStyle: true, pointStyle: 'circle' },
        },
        tooltip: {
          callbacks: {
            label(item) {
              if (item.dataset.yAxisID === 'y1') {
                return '平均遊戲時間 ' + rangeStats.avgLabels[item.dataIndex];
              }
              return item.dataset.label + ': ' + item.parsed.y;
            },
          },
        },
      },
      scales: {
        x: {
          ticks: { color: '#94a3b8' },
          grid: { color: 'rgba(255,255,255,0.12)', borderDash: [4, 4] },
        },
        y: {
          beginAtZero: true,
          ticks: { color: '#94a3b8', precision: 0 },
          grid: { color: 'rgba(255,255,255,0.12)', borderDash: [4, 4] },
          title: { display: true, text: '次數', color: '#94a3b8' },
        },
        y1: {
          beginAtZero: true,
          position: 'right',
          grid: { drawOnChartArea: false },
          ticks: { color: '#fda4af' },
          title: { display: true, text: '平均秒數', color: '#fda4af' },
        },
      },
    },
  });
</script>
