<section class="space-y-6">
  <div>
    <h2 class="font-serif text-3xl text-amber-200">Game Config</h2>
    <p class="mt-1 text-sm text-slate-400">全域設定（秒 / float）</p>
  </div>

  <% if (error) { %>
  <p class="rounded bg-rose-500/20 px-3 py-2 text-sm text-rose-200"><%= error %></p>
  <% } %>
  <% if (success) { %>
  <p class="rounded bg-emerald-500/20 px-3 py-2 text-sm text-emerald-200"><%= success %></p>
  <% } %>

  <form method="post" action="/dashboard/config" class="max-w-lg space-y-4 rounded-2xl border border-white/10 bg-white/5 p-5">
    <label class="block text-sm">
      <span class="text-slate-400">max_timer（秒）</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="number" min="1" step="1" name="max_timer" value="<%= config.max_timer %>" required />
    </label>
    <label class="block text-sm">
      <span class="text-slate-400">answer_timer（秒）</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="number" min="1" step="1" name="answer_timer" value="<%= config.answer_timer %>" required />
    </label>
    <label class="block text-sm">
      <span class="text-slate-400">circle_radius（float）</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="number" min="0.0001" step="any" name="circle_radius" value="<%= config.circle_radius %>" required />
    </label>
    <button class="rounded-lg bg-sky-500 px-4 py-2 text-slate-950 hover:bg-sky-400" type="submit">儲存</button>
  </form>
</section>
