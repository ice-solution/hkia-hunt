<section class="space-y-6">
  <div>
    <h2 class="font-serif text-3xl text-amber-200">Device 管理</h2>
    <p class="mt-1 text-sm text-slate-400">僅管理員可建立 / 重設密碼（<%= passwordHint %>）</p>
  </div>

  <% if (error) { %>
  <p class="rounded bg-rose-500/20 px-3 py-2 text-sm text-rose-200"><%= error %></p>
  <% } %>
  <% if (success) { %>
  <p class="rounded bg-emerald-500/20 px-3 py-2 text-sm text-emerald-200"><%= success %></p>
  <% } %>

  <form method="post" action="/dashboard/devices" class="grid gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 sm:grid-cols-4">
    <label class="text-sm sm:col-span-1">
      <span class="text-slate-400">device_id</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" name="device_id" required />
    </label>
    <label class="text-sm sm:col-span-1">
      <span class="text-slate-400">password</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" type="password" name="password" required />
    </label>
    <label class="text-sm sm:col-span-1">
      <span class="text-slate-400">備註</span>
      <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2" name="label" />
    </label>
    <div class="flex items-end">
      <button class="w-full rounded-lg bg-sky-500 px-4 py-2 text-slate-950 hover:bg-sky-400" type="submit">新增 Device</button>
    </div>
  </form>

  <div class="overflow-x-auto rounded-2xl border border-white/10">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-white/5 text-slate-300">
        <tr>
          <th class="px-3 py-2">device_id</th>
          <th class="px-3 py-2">備註</th>
          <th class="px-3 py-2">狀態</th>
          <th class="px-3 py-2">建立(HKT)</th>
          <th class="px-3 py-2">重設密碼</th>
          <th class="px-3 py-2">啟用/停用</th>
        </tr>
      </thead>
      <tbody>
        <% devices.forEach(function (d) { %>
        <tr class="border-t border-white/5">
          <td class="px-3 py-2 font-mono"><%= d.device_id %></td>
          <td class="px-3 py-2"><%= d.label || '—' %></td>
          <td class="px-3 py-2"><%= d.active ? '啟用' : '停用' %></td>
          <td class="px-3 py-2 text-slate-400"><%= d.createdAtHkt %></td>
          <td class="px-3 py-2">
            <form class="flex gap-2" method="post" action="/dashboard/devices/<%= d._id %>/password">
              <input class="w-40 rounded border border-white/10 bg-slate-900 px-2 py-1" type="password" name="password" placeholder="新密碼" required />
              <button class="rounded bg-white/10 px-2 py-1 hover:bg-white/20" type="submit">更新</button>
            </form>
          </td>
          <td class="px-3 py-2">
            <form method="post" action="/dashboard/devices/<%= d._id %>/toggle">
              <button class="rounded bg-white/10 px-2 py-1 hover:bg-white/20" type="submit"><%= d.active ? '停用' : '啟用' %></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
