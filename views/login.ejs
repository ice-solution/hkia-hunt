<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> · 尋寶挑戰百萬賞</title>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(14,165,233,0.22),_transparent_50%),linear-gradient(160deg,#020617,#0f172a_45%,#111827)]"></div>
    <div class="relative mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-10">
      <div class="mb-8 text-center">
        <p class="text-xs uppercase tracking-[0.25em] text-sky-300/80">Dashboard</p>
        <h1 class="mt-2 font-serif text-4xl text-amber-200">尋寶挑戰百萬賞</h1>
        <p class="mt-2 text-sm text-slate-400">後台登入</p>
      </div>
      <form method="post" action="/dashboard/login" class="space-y-4 rounded-2xl border border-white/10 bg-white/5 p-6 shadow-2xl shadow-sky-950/40">
        <% if (error) { %>
        <p class="rounded bg-rose-500/20 px-3 py-2 text-sm text-rose-200"><%= error %></p>
        <% } %>
        <label class="block text-sm">
          <span class="text-slate-300">帳號</span>
          <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2 outline-none focus:border-sky-400" name="username" required autocomplete="username" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-300">密碼</span>
          <input class="mt-1 w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2 outline-none focus:border-sky-400" type="password" name="password" required autocomplete="current-password" />
        </label>
        <button class="w-full rounded-lg bg-sky-500 px-4 py-2.5 font-medium text-slate-950 hover:bg-sky-400" type="submit">登入</button>
      </form>
    </div>
  </body>
</html>
