<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> · <%= typeof eventName !== 'undefined' ? eventName : '尋寶挑戰百萬賞' %></title>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(14,165,233,0.18),_transparent_55%),radial-gradient(ellipse_at_bottom_right,_rgba(245,158,11,0.12),_transparent_45%)]"></div>
    <div class="relative">
      <% if (typeof staff !== 'undefined' && staff) { %>
      <header class="border-b border-white/10 bg-slate-950/70 backdrop-blur">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-sky-300/80">HKIA Rally</p>
            <h1 class="font-serif text-2xl text-amber-200"><%= eventName %></h1>
          </div>
          <nav class="flex flex-wrap items-center gap-3 text-sm">
            <a class="hover:text-sky-300" href="/dashboard">總覽</a>
            <a class="hover:text-sky-300" href="/dashboard/logs">遊戲紀錄</a>
            <a class="hover:text-sky-300" href="/dashboard/ranking">排行榜</a>
            <% if (staff.role === 'admin') { %>
            <a class="hover:text-sky-300" href="/dashboard/devices">Devices</a>
            <a class="hover:text-sky-300" href="/dashboard/config">Game Config</a>
            <a class="hover:text-sky-300" href="/dashboard/accounts">帳號</a>
            <% } %>
            <span class="rounded border border-white/15 px-2 py-1 text-slate-300"><%= staff.username %> · <%= staff.role %></span>
            <form method="post" action="/dashboard/logout">
              <button class="rounded bg-white/10 px-3 py-1 hover:bg-white/20" type="submit">登出</button>
            </form>
          </nav>
        </div>
      </header>
      <% } %>
      <main class="mx-auto max-w-6xl px-4 py-8">
        <%- body %>
      </main>
    </div>
  </body>
</html>
