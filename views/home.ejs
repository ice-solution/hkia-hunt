<section class="space-y-6">
  <div>
    <h2 class="font-serif text-3xl text-amber-200">總覽</h2>
    <p class="mt-1 text-slate-400">今日（GMT+8）：<%= today %></p>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
      <p class="text-sm text-slate-400">今日遊玩次數</p>
      <p class="mt-2 text-3xl font-semibold text-sky-300"><%= todayCount %></p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
      <p class="text-sm text-slate-400">啟用 Device</p>
      <p class="mt-2 text-3xl font-semibold text-amber-200"><%= deviceCount %></p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
      <p class="text-sm text-slate-400">累計 Game Log</p>
      <p class="mt-2 text-3xl font-semibold text-emerald-300"><%= totalLogs %></p>
    </div>
  </div>
  <a class="inline-flex rounded-lg bg-sky-500 px-4 py-2 text-slate-950 hover:bg-sky-400" href="/dashboard/logs">查看遊戲紀錄</a>
</section>
